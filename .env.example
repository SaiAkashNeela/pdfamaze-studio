# The web app (src/) reads no environment variables: it is a static, client-side site and
# needs no secrets. Do not add server secrets here without updating AGENTS.md.

# Mobile app (mobile-app/) build variant, set per EAS build profile in mobile-app/eas.json.
# "production" makes Android builds drop the INTERNET (and two unused) permissions and turns
# off over-the-air updates on Android (mobile-app/app.config.ts,
# mobile-app/plugins/with-offline-android-updates.js). Any other value keeps network access
# for the Metro dev server and preview builds.
APP_VARIANT=development
