{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "pdfamaze",
	"main": ".output/server/index.mjs",
	"compatibility_date": "2026-08-26",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": ".output/public",
		"binding": "ASSETS"
	},
	"kv_namespaces": [
		{
			"binding": "STATS_KV",
			"id": "c792dcc372604061aaa957e9cc46844e",
			"remote": true
		}
	],
	"routes": [
		{
			"pattern": "pdfamaze.com",
			"custom_domain": true
		}
	]
}
